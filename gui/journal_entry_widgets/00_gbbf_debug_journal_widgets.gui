			onclick = "[GetVariableSystem.Toggle('gbbf_show_levafm_module')]"
		}
	}
	
	type gbbf_module_container_eqfm = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 520 -1 }
		spacing = 10
		margin = { 10 10 }
		
		background = {
			using = entry_bg
		}
		
		button = {
			parentanchor = top|hcenter
			using = editor_button
			size = { 150 35 }
			raw_text = "Module EQFM"
			onclick = "[GetVariableSystem.Toggle('gbbf_show_eqfm_module')]"
		}
	}
	
	type gbbf_module_container_aracp = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 520 -1 }
		spacing = 10
		margin = { 10 10 }
		
		background = {
			using = entry_bg
		}
		
		button = {
			parentanchor = top|hcenter
			using = editor_button
			size = { 150 35 }
			raw_text = "Module ARACP"
			onclick = "[GetVariableSystem.Toggle('gbbf_show_aracp_module')]"
		}
	}
	
	type gbbf_debug_scripted_button = editor_button {
		parentanchor = top|hcenter
		block "button_visibility" {
			visible = "[ScriptedButton.HasTag('nope')]"
		}
		block "button_size" {
			size = { 400 30 }
		}
		text = "[ScriptedButton.GetName]"
		default_format = "#b"
		align = center|nobaseline
		fontcolor = { 1 1 1 1 }
		fontsize = 14
		enabled = "[IsValid( ScriptedButton.ExecuteEffect )]"
		onclick = "[Execute( ScriptedButton.ExecuteEffect )]"
		tooltip = "SCRIPTED_ACTION_TOOLTIP"
		using = tooltip_above
	}
}