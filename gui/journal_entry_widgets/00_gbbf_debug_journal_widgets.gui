# INHERITED FROM BASE GAME
@panel_width_minus_30 = 510
@panel_width_minus_20 = 520
@panel_width_minus_10 = 530 # used to be 450
@panel_width = 540 # used to be 460
@panel_width_half = 270 # used to be 230
@panel_width_plus_10 = 550 # used to be 470
@panel_width_plus_14 = 554 # used to be 474
@panel_width_plus_14_half = 277 # used to be 237
@panel_width_plus_20 = 560 # used to be 480
@panel_width_plus_30 = 570 # used to be 490
@panel_width_plus_70 = 610 # used to be 530

####---------- INJECTABLE JOURNAL ENTRY WIDGETS ----------####
flowcontainer = {
	name = "widget_gbbf_debug"
	ignoreinvisible = yes
	
	flowcontainer = {
		parentanchor = center
		direction = vertical
		spacing = 10
		
		using = dockable_background
		
		background = {
			using = dark_area
			margin = { 5 5 }
		}
		
		gbbf_debug_menu = {}
		gbbf_cheat_menu = {}
		#gbbf_module_container_grefm = {}
		#gbbf_module_container_balkfm = {}
		#gbbf_module_container_turkfm = {}
		#gbbf_module_container_mgrbfm = {}
		#gbbf_module_container_haykfm = {}
		#gbbf_module_container_levafm = {}
		#gbbf_module_container_eqfm = {}
		#gbbf_module_container_aracp = {}
	}
}

####---------- INJECTABLE JOURNAL ENTRY TYPES ----------####

types gbbf_journal_entry_widget_types {
	
	type gbbf_cheat_menu = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 540 -1 }
		spacing = 10
		margin = { 10 10 }
		
		background = {
			using = entry_bg
		}
		
		button = {
			parentanchor = top|hcenter
			using = editor_button
			size = { 150 35 }
			raw_text = "Cheat Options"
			onclick = "[GetVariableSystem.Toggle('gbbf_show_cheat_buttons')]"
		}
		
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			minimumsize = { 520 100 }
			spacing = 5
			
			visible = "[GetVariableSystem.Exists('gbbf_show_cheat_buttons')]"
			datamodel = "[JournalEntry.GetScriptedButtons]"
			
			item = {
				gbbf_debug_scripted_button = {
					blockoverride "button_visibility" {
						visible = "[ScriptedButton.HasTag('cheat')]"
					}
				}
			}
		}
	}
	
	type gbbf_debug_menu = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 540 -1 }
		spacing = 10
		margin = { 10 10 }
		
		background = {
			using = entry_bg
		}
		
		button = {
			parentanchor = top|hcenter
			using = editor_button
			size = { 150 35 }
			raw_text = "Debug Options"
			onclick = "[GetVariableSystem.Toggle('gbbf_show_debug_buttons')]"
		}
		
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			minimumsize = { 520 100 }
			spacing = 5
			
			visible = "[GetVariableSystem.Exists('gbbf_show_debug_buttons')]"
			datamodel = "[JournalEntry.GetScriptedButtons]"
			
			item = {
				gbbf_debug_scripted_button = {
					blockoverride "button_visibility" {
						visible = "[ScriptedButton.HasTag('debug')]"
					}
				}
			}
		}
	}
	
	type gbbf_module_container_grefm = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 520 -1 }
		spacing = 10
		margin = { 10 10 }
		
		background = {
			using = entry_bg
		}
		
		button = {
			parentanchor = top|hcenter
			using = editor_button
			size = { 150 35 }
			raw_text = "Module GREFM"
			onclick = "[GetVariableSystem.Toggle('gbbf_show_grefm_module')]"
		}
	}
	
	type gbbf_module_container_balkfm = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 520 -1 }
		spacing = 10
		margin = { 10 10 }
		
		background = {
			using = entry_bg
		}
		
		button = {
			parentanchor = top|hcenter
			using = editor_button
			size = { 150 35 }
			raw_text = "Module BALKFM"
			onclick = "[GetVariableSystem.Toggle('gbbf_show_balkfm_module')]"
		}
	}
	
	type gbbf_module_container_turkfm = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 520 -1 }
		spacing = 10
		margin = { 10 10 }
		
