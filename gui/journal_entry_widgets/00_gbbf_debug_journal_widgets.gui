			using = entry_bg
		}
		
		button = {
			parentanchor = top|hcenter
			using = editor_button
			size = { 150 35 }
			raw_text = "Module GREFM"
			onclick = "[GetVariableSystem.Toggle('gbbf_show_turkfm_module')]"
		}
	}
	
