		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 520 -1 }
		spacing = 10
		margin = { 10 10 }
		
		background = {
			using = entry_bg
		}
		
		button = {
			parentanchor = top|hcenter
			using = editor_button
			size = { 150 35 }
			raw_text = "Module HAYKFM"
			onclick = "[GetVariableSystem.Toggle('gbbf_show_haykfm_module')]"
		}
	}
	
	type gbbf_module_container_levafm = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 520 -1 }
		spacing = 10
		margin = { 10 10 }
		
		background = {
			using = entry_bg
		}
		
		button = {
			parentanchor = top|hcenter
			using = editor_button
			size = { 150 35 }
