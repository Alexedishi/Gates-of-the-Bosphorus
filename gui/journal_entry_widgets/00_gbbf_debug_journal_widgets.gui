		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 520 -1 }
		spacing = 10
		margin = { 10 10 }
		
		background = {
			using = entry_bg
		}
		
		button = {
			parentanchor = top|hcenter
			using = editor_button
			size = { 150 35 }
