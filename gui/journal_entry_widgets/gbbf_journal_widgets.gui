# INHERITED FROM BASE GAME
@panel_width_minus_30 = 510
@panel_width_minus_20 = 520
@panel_width_minus_10 = 530 # used to be 450
@panel_width = 540 # used to be 460
@panel_width_half = 270 # used to be 230
@panel_width_plus_10 = 550 # used to be 470
@panel_width_plus_14 = 554 # used to be 474
@panel_width_plus_14_half = 277 # used to be 237
@panel_width_plus_20 = 560 # used to be 480
@panel_width_plus_30 = 570 # used to be 490
@panel_width_plus_70 = 610 # used to be 530

####---------- INJECTABLE JOURNAL ENTRY WIDGETS ----------####
flowcontainer = {
	name = "widget_gbbf_sanusiyyah_situation"
	ignoreinvisible = yes
	
	flowcontainer = {
		direction = vertical
		spacing = 5
		
		gbbf_sanusiyya_tab_buttons = {}
		com_journal_reason_text = {
			visible = "[Or(
				GetVariableSystem.HasValue('eqfm_sanusiyya_tab', 'overview'),
				Not(GetVariableSystem.Exists('eqfm_sanusiyya_tab'))
			)]"
			maximumsize = { 520 -1 }
		}
		gbbf_sanusiyyah_georegion_status = {}
		gbbf_sanusiyyah_involvement_details = {}
		gbbf_sanusiyyah_expedition_details = {}
	}
}

####---------- INJECTABLE JOURNAL ENTRY TYPES ----------####

types gbbf_journal_widget_types {
	
	type gbbf_sanusiyya_tab_buttons = widget {
		parentanchor = top|hcenter
		size = { 540 40 }
		
		tab_buttons = {
			parentanchor = center
			# OVERVIEW TAB
			blockoverride "first_button" {
				text = "eqfm_gui_sanusiyya_overview_header"
			}
			blockoverride "first_button_selected" {
				text = "eqfm_gui_sanusiyya_overview_header"
			}
			blockoverride "first_button_visibility_checked" {
				visible = "[And(
					Not(GetVariableSystem.HasValue('eqfm_sanusiyya_tab', 'overview')),
					GetVariableSystem.Exists('eqfm_sanusiyya_tab')
				)]"
			}
			blockoverride "first_button_visibility" {
				visible = "[Or(
					GetVariableSystem.HasValue('eqfm_sanusiyya_tab', 'overview'),
					Not(GetVariableSystem.Exists('eqfm_sanusiyya_tab'))
				)]"
			}
			blockoverride "first_button_click" {
				onclick = "[GetVariableSystem.Set('eqfm_sanusiyya_tab', 'overview')]"
			}
			
			# STATE REGIONS TAB
			blockoverride "second_button" {
				text = "eqfm_gui_state_regions_header"
			}
			blockoverride "second_button_selected" {
				text = "eqfm_gui_state_regions_header"
			}
			blockoverride "second_button_visibility_checked" {
				visible = "[Not(GetVariableSystem.HasValue('eqfm_sanusiyya_tab', 'regions'))]"
			}
			blockoverride "second_button_visibility" {
				visible = "[GetVariableSystem.HasValue('eqfm_sanusiyya_tab', 'regions')]"
			}
			blockoverride "second_button_click" {
				onclick = "[GetVariableSystem.Set('eqfm_sanusiyya_tab', 'regions')]"
			}
			
			# INVOLVEMENT TAB
			blockoverride "third_button" {
				text = "eqfm_gui_involvement_header"
			}
			blockoverride "third_button_selected" {
				text = "eqfm_gui_involvement_header"
			}
			blockoverride "third_button_visibility_checked" {
				visible = "[Not(GetVariableSystem.HasValue('eqfm_sanusiyya_tab', 'involvement'))]"
			}
			blockoverride "third_button_visibility" {
				visible = "[GetVariableSystem.HasValue('eqfm_sanusiyya_tab', 'involvement')]"
			}
			blockoverride "third_button_click" {
				onclick = "[GetVariableSystem.Set('eqfm_sanusiyya_tab', 'involvement')]"
			}
			
			# EXPEDITION TAB
			blockoverride "third_button" {
				text = "eqfm_gui_expedition_header"
			}
			blockoverride "third_button_selected" {
				text = "eqfm_gui_expedition_header"
			}
			blockoverride "third_button_visibility_checked" {
				visible = "[Not(GetVariableSystem.HasValue('eqfm_sanusiyya_tab', 'expedition'))]"
			}
			blockoverride "third_button_visibility" {
				visible = "[GetVariableSystem.HasValue('eqfm_sanusiyya_tab', 'expedition')]"
			}
			blockoverride "third_button_click" {
				onclick = "[GetVariableSystem.Set('eqfm_sanusiyya_tab', 'expedition')]"
			}
		}
	}
	
	type gbbf_sanusiyyah_georegion_status = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 520 -1 }
		margin = { 10 10 }
		spacing = 5
		
		visible = "[GetVariableSystem.HasValue('eqfm_sanusiyya_tab', 'regions')]"
		
		using = entry_bg_fancy
		
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			spacing = 15
			
			gbbf_sanusiyyah_state_region_item = {
				blockoverride "state_region_datacontext" {
					datacontext = "[GetStateRegion('STATE_HEDJAZ')]"
				}
				blockoverride "state_region_background" {
					texture = "/gfx/interface/illustrations/situation_backgrounds/gbbf_situation_background_arab_urban.dds"
				}
				blockoverride "spread_button_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_hedjaz'),
						ScriptedButton.HasTag('spread_action')
					)]"
				}
				blockoverride "expel_button_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_hedjaz'),
						ScriptedButton.HasTag('expel_action')
					)]"
				}
				blockoverride "button_column_1_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_hedjaz'),
						ScriptedButton.HasTag('diplo_action')
					)]"
				}
				blockoverride "button_column_2_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_hedjaz'),
						ScriptedButton.HasTag('repeatable_action')
					)]"
				}
			}
			gbbf_sanusiyyah_state_region_item = {
				blockoverride "state_region_datacontext" {
					datacontext = "[GetStateRegion('STATE_TRIPOLI')]"
				}
				blockoverride "state_region_background" {
					texture = "/gfx/interface/illustrations/situation_backgrounds/gbbf_situation_background_arab_urban.dds"
				}
				blockoverride "button_column_1_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_tripoli'),
						ScriptedButton.HasTag('diplo_action')
					)]"
				}
				blockoverride "button_column_2_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_tripoli'),
						ScriptedButton.HasTag('repeatable_action')
					)]"
				}
			}
			gbbf_sanusiyyah_state_region_item = {
				blockoverride "state_region_datacontext" {
					datacontext = "[GetStateRegion('STATE_LIBYA')]"
				}
				blockoverride "state_region_background" {
					texture = "/gfx/interface/illustrations/situation_backgrounds/gbbf_situation_background_desert_traders.dds"
				}
				blockoverride "button_column_1_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_libya'),
						ScriptedButton.HasTag('diplo_action')
					)]"
				}
				blockoverride "button_column_2_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_libya'),
						ScriptedButton.HasTag('repeatable_action')
					)]"
				}
			}
			gbbf_sanusiyyah_state_region_item = {
				blockoverride "state_region_datacontext" {
					datacontext = "[GetStateRegion('STATE_LIBYAN_DESERT')]"
				}
				blockoverride "state_region_background" {
					texture = "/gfx/interface/illustrations/situation_backgrounds/gbbf_situation_background_desert_traders.dds"
				}
				blockoverride "button_column_1_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_libyan_desert'),
						ScriptedButton.HasTag('diplo_action')
					)]"
				}
				blockoverride "button_column_2_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_libyan_desert'),
						ScriptedButton.HasTag('repeatable_action')
					)]"
				}
			}
			gbbf_sanusiyyah_state_region_item = {
				blockoverride "state_region_datacontext" {
					datacontext = "[GetStateRegion('STATE_MATRUH')]"
				}
				blockoverride "button_column_1_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_matruh'),
						ScriptedButton.HasTag('diplo_action')
					)]"
				}
				blockoverride "button_column_2_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_matruh'),
						ScriptedButton.HasTag('repeatable_action')
					)]"
				}
			}
			gbbf_sanusiyyah_state_region_item = {
				blockoverride "state_region_datacontext" {
					datacontext = "[GetStateRegion('STATE_EGYPTIAN_DESERT')]"
				}
				blockoverride "button_column_1_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_egyptian_desert'),
						ScriptedButton.HasTag('diplo_action')
					)]"
				}
				blockoverride "button_column_2_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_egyptian_desert'),
						ScriptedButton.HasTag('repeatable_action')
					)]"
				}
			}
			gbbf_sanusiyyah_state_region_item = {
				blockoverride "state_region_datacontext" {
					datacontext = "[GetStateRegion('STATE_CHAD')]"
				}
				blockoverride "state_region_background" {
					texture = "/gfx/interface/illustrations/situation_backgrounds/gbbf_situation_background_mountain_arid.dds"
				}
				blockoverride "button_column_1_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_chad'),
						ScriptedButton.HasTag('diplo_action')
					)]"
				}
				blockoverride "button_column_2_visibility" {
					visible = "[And(
						ScriptedButton.HasTag('state_chad'),
						ScriptedButton.HasTag('repeatable_action')
					)]"
				}
			}
		}
	}
	
	type gbbf_sanusiyyah_state_region_item = widget {
		parentanchor = top|hcenter
		size = { @panel_width_minus_20 140 }
		
		block "state_region_datacontext" {}
		
		icon = {
			using = dark_area
			using = frame_small_mask
			parentanchor = right
			size = { 240 140 }
			alpha = 0.2
			position = { 0 0 }
			
			modify_texture = {
				texture = "gfx/interface/masks/fade_horizontal_left.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = alphamultiply
			}
		}
		
		background = {
			block "state_region_background" {
				texture = "/gfx/interface/illustrations/situation_backgrounds/gbbf_situation_background_desert.dds"
			}
			using = frame_small_mask
			alpha = 0.65
		}
		
		background = {
			texture = "gfx/interface/backgrounds/subject_liberty_desire_frame.dds"
		}
		
		widget = {
			parentanchor = bottom
			position = { 0 10 }
			size = { 307 52 }
			
			# Active Entrenchment Progress Bar
			gold_progressbar_horizontal = {
				parentanchor = center
				size = { 220 15 }
				position = { 0 7 }
				allow_outside = yes
				tooltip = eqfm_gui_entrenchment_value
				
				visible = "[And(
					StateRegion.MakeScope.Var('eqfm_sanusiyyah_entrenchment_var').IsSet,
					Not(EqualTo_CFixedPoint( StateRegion.MakeScope.Var('eqfm_sanusiyyah_entrenchment_var').GetValue, '(CFixedPoint)0' ))
				)]"
				
				blockoverride "frame" {}
				blockoverride "glow_visible" {
					visible = "no"
				}
				blockoverride "values" {
					value = "[StateRegion.MakeScope.Var('eqfm_sanusiyyah_entrenchment_var').GetValue]"
					min = 0
					max = 100
				}
			}
			
			# No Entrenchment Progress Bar
			gold_progressbar_horizontal = {
				parentanchor = center
				size = { 220 15 }
				position = { 0 7 }
				allow_outside = yes
				
				visible = "[Or(
					Not(StateRegion.MakeScope.Var('eqfm_sanusiyyah_entrenchment_var').IsSet),
					EqualTo_CFixedPoint( StateRegion.MakeScope.Var('eqfm_sanusiyyah_entrenchment_var').GetValue, '(CFixedPoint)0' )
				)]"
				blockoverride "frame" {}
				blockoverride "glow_visible" {
					visible = "no"
				}
				blockoverride "values" {
					value = "0"
					min = 0
					max = 100
				}
			}
			
			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/backgrounds/subject_liberty_desire_bar.dds"
			}
			
			textbox = {
				visible = "[Or(
					Not(StateRegion.MakeScope.Var('eqfm_sanusiyyah_entrenchment_var').IsSet),
					EqualTo_CFixedPoint( StateRegion.MakeScope.Var('eqfm_sanusiyyah_entrenchment_var').GetValue, '(CFixedPoint)0' )
				)]"
				
				parentanchor = center
				position = { 0 7 }
				text = "eqfm_gui_no_entrenchment"
				autoresize = yes
				max_width = 220
				align = center|nobaseline
				elide = right
				using = fontsize_medium
				default_format = "#b;lore"
				
				background = {
					using = dark_area
					margin = { 24 0 }
				}
			}
		}
		
		flowcontainer = {
			parentanchor = bottom|left
			position = { 6 6 }
			direction = vertical
			ignoreinvisible = yes
			datamodel = "[JournalEntry.GetScriptedButtons]"
			
			item = {
				gbbf_sanusiyyah_scripted_button_round = {
					blockoverride "major_button_visibility" {
						block "expel_button_visibility" {
							visible = "[ScriptedButton.HasTag('nope')]"
						}
					}
				}
			}
		}
		
		flowcontainer = {
			parentanchor = bottom|hcenter
			position = { 22 6 }
			direction = vertical
			ignoreinvisible = yes
			datamodel = "[JournalEntry.GetScriptedButtons]"
			
			item = {
				gbbf_sanusiyyah_scripted_button_round = {
					blockoverride "major_button_visibility" {
						block "spread_button_visibility" {
							visible = "[ScriptedButton.HasTag('nope')]"
						}
					}
				}
			}
		}
		
		flowcontainer = {
			parentanchor = left|top
			direction = vertical
			position = { 20 6 }
			
			background = {
				using = dark_area
				alpha = 0.5
				margin = { 15 2 }
				modify_texture = {
					texture = "gfx/interface/masks/fade_horizontal_right.dds"
					spriteType = Corneredstretched
					spriteborder = { 0 0 }
					blend_mode = alphamultiply
					alpha = 0.75
				}
			}
			
			widget = {
				parentanchor = top|hcenter
				size = { 250 40 }
				
				hbox = {
					spacing = 5
					
					textbox = {
						autoresize = yes
						align = nobaseline
						elide = right
						fontsize_min = 12
						using = fontsize_large
						text = "eqfm_gui_state_region_name"
					}
					
					icon = {
						size = { 35 35 }
						visible = "[StateRegion.MakeScope.Var('eqfm_sanusiyyah_hq_var').IsSet]"
						texture = "gfx/interface/icons/battle_conditions/battle_condition_dug_in.dds"
						tooltip = eqfm_gui_sanusiyya_headquarters_tooltip
					}
					icon = {
						size = { 35 35 }
						visible = "[And(
							StateRegion.MakeScope.Var('eqfm_sanusiyyah_entrenchment_var').IsSet,
							Not(StateRegion.MakeScope.Var('eqfm_sanusiyyah_exposed_lodge_var').IsSet)
						)]"
						texture = "gfx/interface/icons/battle_conditions/battle_condition_camouflaged.dds"
						tooltip = eqfm_gui_sanusiyya_hidden_loddge_tooltip
					}
					icon = {
						size = { 35 35 }
						visible = "[And(
							StateRegion.MakeScope.Var('eqfm_sanusiyyah_entrenchment_var').IsSet,
							StateRegion.MakeScope.Var('eqfm_sanusiyyah_exposed_lodge_var').IsSet
						)]"
						texture = "gfx/interface/icons/battle_conditions/battle_condition_good_visibility.dds"
						tooltip = eqfm_gui_sanusiyya_exposed_loddge_tooltip
					}
					
					expand = {}
				}
			}
			
			textbox = {
				autoresize = yes
				align = nobaseline
				text = "eqfm_gui_state_region_bedouin_pops"
			}
			
			textbox = {
				autoresize = yes
				align = nobaseline
				text = "eqfm_gui_state_region_bedouin_radicalism"
			}
		}
		
		flowcontainer = {
			parentanchor = right|vcenter
			direction = horizontal
			minimumsize = { 110 120 }
			maximumsize = { 110 120 }
			position = { -10 0 }
			margin_left = 5
			spacing = 10
			
			background = {
				using = dark_area
				margin = { 5 5 }
				alpha = 0.5
			}
			
			vertical_divider_stronger_full = {}
			
			flowcontainer = {
				parentanchor = right|vcenter
				direction = vertical
				datamodel = "[JournalEntry.GetScriptedButtons]"
				spacing = 3
				
				item = {
					gbbf_sanusiyyah_scripted_button_item = {
						block "button_column_1_visibility" {
							visible = no
						}
					}
				}
			}
			
			flowcontainer = {
				parentanchor = right|vcenter
				direction = vertical
				datamodel = "[JournalEntry.GetScriptedButtons]"
				spacing = 5
				
				item = {
					gbbf_sanusiyyah_scripted_button_item = {
						block "button_column_2_visibility" {
							visible = no
						}
					}
				}
			}
		}
	}
	
	type gbbf_sanusiyyah_scripted_button_item = button {
		parentanchor = top|hcenter
		using = default_button
		using = tooltip_above
		size = { 40 40 }
		enabled = "[IsValid( ScriptedButton.ExecuteEffect )]"
		onclick = "[Execute( ScriptedButton.ExecuteEffect )]"
		tooltip = "SCRIPTED_ACTION_TOOLTIP"
		
		widget = {
			visible = "[ScriptedButton.IsSelected]"
			size = { 100% 100% }
			
			background = {
				using = paper_bg
			}
		}
		icon = {
			parentanchor = center
			size = { 85% 85% }
			texture = "[ScriptedButton.GetIcon]"
		}
		icon = {
			visible = "[ScriptedButton.IsSelected]"
			using = highlighted_square_selection
		}
	}
	
	type gbbf_sanusiyyah_scripted_button_round = button_icon_round {
		size = { 40 40 }
		using = tooltip_above
		enabled = "[IsValid( ScriptedButton.ExecuteEffect )]"
		onclick = "[Execute( ScriptedButton.ExecuteEffect )]"
		tooltip = "SCRIPTED_ACTION_TOOLTIP"
		
		block "major_button_visibility" {
			visible = "[ScriptedButton.HasTag('nope')]"
		}
		
		icon = {
			parentanchor = center
			size = { 75% 75% }
			texture = "[ScriptedButton.GetIcon]"
		}
		icon = {
			visible = "[ScriptedButton.IsSelected]"
			size = { 100% 100% }
			using = circle_bg_simple_dark
		}
		icon = {
			visible = "[ScriptedButton.IsSelected]"
			using = highlighted_circle_selection_small
		}
	}
	
	type gbbf_sanusiyyah_involvement_details = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		spacing = 5
		using = entry_bg_fancy
		margin = { 8 10 }
		
		visible = "[GetVariableSystem.HasValue('eqfm_sanusiyya_tab', 'involvement')]"
		
		# Stances
		widget = {
			parentanchor = top|hcenter
			size = { 520 30 }
			
			hbox = {
				maximumsize = { 520 -1 }
				button = {
					size = { 220 30 }
					using = sort_button_bg
					enabled = no
					text = "eqfm_gui_sanusiyyah_country_header_header"
					align = hcenter|nobaseline
					margin_left = 10
					margin_right = 10
					elide = right
				}
				button = {
					size = { 150 30 }
					using = sort_button_bg
					enabled = no
					text = "eqfm_gui_sanusiyyah_stance_header"
					align = hcenter|nobaseline
					margin_left = 10
					margin_right = 10
					elide = right
				}
				button = {
					size = { 150 30 }
					using = sort_button_bg
					enabled = no
					text = "eqfm_gui_sanusiyyah_influence_header"
					align = hcenter|nobaseline
					margin_left = 10
					margin_right = 10
					elide = right
				}
				expand = { }
			}
		}
		
		# Involved Countries
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			spacing = 5
			datamodel = "[JournalEntry.GetInvolvedCountries]"
			
			item = {
				flowcontainer = {
					parentanchor = top|hcenter
					direction = horizontal
					minimumsize = { 520 30 }
					
					widget = {
						parentanchor = top|hcenter
						size = { 520 30 }
						
						hbox = {
							maximumsize = { 520 -1 }
							
							expand = { }
							
							textbox = {
								size = { 220 30 }
								align = nobaseline
								elide = right
								fontsize_min = 12
								fontsize = 18
								raw_text = "[Country.GetName]"
								default_format = "#b"
							}
							
							textbox = {
								size = { 145 30 }
								align = nobaseline
								elide = right
								fontsize_min = 12
								fontsize = 18
								text = "eqfm_gui_sanusiyyah_country_stance"
								default_format = "#b"
							}
							
							textbox = {
								size = { 140 30 }
								align = nobaseline
								elide = right
								fontsize_min = 12
								fontsize = 18
								text = "eqfm_gui_sanusiyyah_country_influence"
								default_format = "#b;greece"
							}
						}
					}
				}
			}
		}
	}
	
	type gbbf_sanusiyyah_expedition_details = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		minimumsize = { 520 -1 }
		spacing = 5
		using = entry_bg_fancy
		
		visible = "[GetVariableSystem.HasValue('eqfm_sanusiyya_tab', 'expedition')]"
		
		## EXPEDITION COMPOSITION
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			minimumsize = { 500 100 }
			spacing = 5
			
			using = entry_bg_fancy
			
			default_header_clean_faded = {
				size = { 500 50 }
				parentanchor = top|hcenter
				blockoverride "text" { }
				textbox = {
					raw_text = "Expedition Members"
					parentanchor = center
					position = { 0 0 }
					autoresize = yes
					max_width = 300
					elide = right
					using = fontsize_mega
				}
			}
			
			textbox = {
				parentanchor = center
				size = { 500 50 }
				raw_text = "[GetPlayer.GetNameNoFlag] does not have expedition"
				align = center|nobaseline
				elide = right
				using = fontsize_large
				
				background = {
					using = dark_area
					alpha = 0.4
					margin = { -5 -5 }
					
					modify_texture = {
						texture = "gfx/interface/masks/fade_horizontal_center.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 0 }
						blend_mode = alphamultiply
					}
					modify_texture = {
						texture = "gfx/interface/masks/fade_vertical_center.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 0 }
						blend_mode = alphamultiply
						alpha = 0.5
					}
				}
			}
		}
		
		## ONGOING EXPEDITIONS
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			minimumsize = { 500 100 }
			spacing = 5
			
			using = entry_bg_fancy
			
			default_header_clean_faded = {
				size = { 500 50 }
				parentanchor = top|hcenter
				blockoverride "text" { }
				textbox = {
					raw_text = "Active Expeditions"
					parentanchor = center
					position = { 0 0 }
					autoresize = yes
					max_width = 300
					elide = right
					using = fontsize_mega
				}
			}
			
			textbox = {
				parentanchor = center
				visible = "[IsDataModelEmpty(JournalEntry.MakeScope.GetList('eqfm_sanusiyyah_expeditions_list'))]"
				size = { 500 50 }
				raw_text = "[GetPlayer.GetNameNoFlag] does not have expedition"
				align = center|nobaseline
				elide = right
				using = fontsize_large
				
				background = {
					using = dark_area
					alpha = 0.4
					margin = { -5 -5 }
					
					modify_texture = {
						texture = "gfx/interface/masks/fade_horizontal_center.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 0 }
						blend_mode = alphamultiply
					}
					modify_texture = {
						texture = "gfx/interface/masks/fade_vertical_center.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 0 }
						blend_mode = alphamultiply
						alpha = 0.5
					}
				}
			}
		}
	}
	
	type gbbf_sanusiyya_expedition_item = widget {
		parentanchor = top|hcenter
		minimumsize = { 500 160 }
		
		using = entry_bg_fancy
		
		
	}
