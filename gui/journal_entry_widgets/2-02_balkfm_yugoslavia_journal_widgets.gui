# INHERITED FROM BASE GAME
@panel_width_minus_30 = 510
@panel_width_minus_20 = 520
@panel_width_minus_10 = 530 # used to be 450
@panel_width = 540 # used to be 460
@panel_width_half = 270 # used to be 230
@panel_width_plus_10 = 550 # used to be 470
@panel_width_plus_14 = 554 # used to be 474
@panel_width_plus_14_half = 277 # used to be 237
@panel_width_plus_20 = 560 # used to be 480
@panel_width_plus_30 = 570 # used to be 490
@panel_width_plus_70 = 610 # used to be 530

####---------- INJECTABLE JOURNAL ENTRY WIDGETS ----------####
flowcontainer = {
	name = "widget_gbbf_yugoslav_nationalism"
	ignoreinvisible = yes
	
	flowcontainer = {
		direction = vertical
		minimumsize = { 520 -1 }
		maximumsize = { 520 -1 }
		margin = { 10 10 }
		spacing = 10
		
		using = entry_bg_fancy
		
		balkfm_yugoslav_culture_item = {
			visible = "[GetScriptedGui('balkfm_montenegrin_culture_integration_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
			blockoverride "culture_name" {
				raw_text = "[GetCulture('montenegrin').GetName]"
			}
			blockoverride "culture_population" {
				raw_text = "Population: #v [JournalEntry.MakeScope.Var('balkfm_montenegrin_total_population_var').GetValue|*]#!"
			}
			blockoverride "culture_loyalists" {
				raw_text = "#v [JournalEntry.MakeScope.Var('balkfm_montenegrin_loyalist_population_var').GetValue|*]#!"
			}
			blockoverride "culture_radicals" {
				raw_text = "#v [JournalEntry.MakeScope.Var('balkfm_montenegrin_radical_population_var').GetValue|*]#!"
			}
			blockoverride "integration_value" {
				value = "[JournalEntry.MakeScope.Var('balkfm_montenegrin_integration_var').GetValue]"
			}
			blockoverride "culture_integrated_visibility" {
				visible = "[GetScriptedGui('balkfm_montenegrin_culture_integration_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
			}
			blockoverride "culture_not_integrated_visibility" {
				visible = "[Not(GetScriptedGui('balkfm_montenegrin_culture_integration_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope ).End))]"
			}
			blockoverride "culture_button_visibility" {
				visible = "[ScriptedButton.HasTag('montenegrin')]"
			}
		}
		balkfm_yugoslav_culture_item = {
			blockoverride "culture_name" {
				raw_text = "[GetCulture('serb').GetName]"
			}
			blockoverride "culture_population" {
				raw_text = "Population: #v [JournalEntry.MakeScope.Var('balkfm_serb_total_population_var').GetValue|*]#!"
			}
			blockoverride "culture_loyalists" {
