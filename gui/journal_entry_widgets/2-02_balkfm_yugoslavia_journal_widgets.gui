			}
			blockoverride "culture_integrated_visibility" {
				visible = "[GetScriptedGui('balkfm_serb_culture_integration_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
			}
			blockoverride "culture_not_integrated_visibility" {
				visible = "[Not(GetScriptedGui('balkfm_serb_culture_integration_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope ).End))]"
			}
			blockoverride "culture_button_visibility" {
				visible = "[ScriptedButton.HasTag('serb')]"
			}
		}
		balkfm_yugoslav_culture_item = {
			visible = "[GetScriptedGui('balkfm_bulgarian_culture_integration_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
			blockoverride "culture_name" {
				raw_text = "[GetCulture('bulgarian').GetName]"
			}
			blockoverride "culture_population" {
				raw_text = "Population: #v [JournalEntry.MakeScope.Var('balkfm_bulgarian_total_population_var').GetValue|*]#!"
			}
			blockoverride "culture_loyalists" {
				raw_text = "#v [JournalEntry.MakeScope.Var('balkfm_bulgarian_loyalist_population_var').GetValue|*]#!"
			}
			blockoverride "culture_radicals" {
				raw_text = "#v [JournalEntry.MakeScope.Var('balkfm_bulgarian_radical_population_var').GetValue|*]#!"
			}
			blockoverride "integration_value" {
