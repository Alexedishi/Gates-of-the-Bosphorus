			}
		}
		balkfm_yugoslav_culture_item = {
			blockoverride "culture_name" {
				raw_text = "[GetCulture('slovene').GetName]"
			}
			blockoverride "culture_population" {
				raw_text = "Population: #v [JournalEntry.MakeScope.Var('balkfm_slovene_total_population_var').GetValue|*]#!"
			}
			blockoverride "culture_loyalists" {
