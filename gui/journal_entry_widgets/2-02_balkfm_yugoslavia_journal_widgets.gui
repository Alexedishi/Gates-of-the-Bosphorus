			}
			blockoverride "culture_integrated_visibility" {
				visible = "[GetScriptedGui('balkfm_bulgarian_culture_integration_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
			}
			blockoverride "culture_not_integrated_visibility" {
				visible = "[Not(GetScriptedGui('balkfm_bulgarian_culture_integration_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope ).End))]"
			}
			blockoverride "culture_button_visibility" {
				visible = "[ScriptedButton.HasTag('bulgarian')]"
			}
		}
		balkfm_yugoslav_culture_item = {
			blockoverride "culture_name" {
				raw_text = "[GetCulture('bosniak').GetName]"
			}
			blockoverride "culture_population" {
				raw_text = "Population: #v [JournalEntry.MakeScope.Var('balkfm_bosniak_total_population_var').GetValue|*]#!"
			}
			blockoverride "culture_loyalists" {
