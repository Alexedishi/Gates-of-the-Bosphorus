			}
			blockoverride "culture_not_integrated_visibility" {
				visible = "[Not(GetScriptedGui('balkfm_croat_culture_integration_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope ).End))]"
			}
