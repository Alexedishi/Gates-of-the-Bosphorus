			}
			blockoverride "culture_radicals" {
				raw_text = "#v [JournalEntry.MakeScope.Var('balkfm_bosniak_radical_population_var').GetValue|*]#!"
			}
			blockoverride "integration_value" {
				value = "[JournalEntry.MakeScope.Var('balkfm_bosniak_integration_var').GetValue]"
			}
			blockoverride "culture_integrated_visibility" {
				visible = "[GetScriptedGui('balkfm_bosniak_culture_integration_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope ).End)]"
			}
			blockoverride "culture_not_integrated_visibility" {
				visible = "[Not(GetScriptedGui('balkfm_bosniak_culture_integration_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope ).End))]"
			}
			blockoverride "culture_button_visibility" {
				visible = "[ScriptedButton.HasTag('bosniak')]"
			}
		}
		balkfm_yugoslav_culture_item = {
			blockoverride "culture_name" {
				raw_text = "[GetCulture('croat').GetName]"
			}
			blockoverride "culture_population" {
